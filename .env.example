# Copy to .env and edit. .env is gitignored; this template is not.
#
# Every key here may be left blank: a blank value means "unset" and the built-in default
# applies. That is why the code reads these with `||` and not `??` — `??` would take the
# empty string as a value, and `LOG_DIR=` alone was enough to kill the server on startup
# with `mkdir ''`. Four keys below are the deliberate exception, where blank *is* the
# answer: ACP_CWD, A2A_AGENTS, MCP_ALLOWED_HOSTS, MCP_TOKEN.
#
# src/agent.ts reads none of this — it takes PORT, HOST and PUBLIC_URL from the
# environment only. The ACP bridge and the MCP bridge both load this file.

# --- The A2A server: src/acp/agent.ts (`yarn agent:claude` / `yarn agent:codex`) ---

# Where the coding agent is allowed to work. Blank means a directory per conversation
# under .acp-sandboxes/ in this repository, created by the bridge itself. That distinction
# matters: inside a directory we made, the classifier permits shell and unverifiable
# edits; inside one you handed us, it does not.
ACP_CWD=

# Force shell and network through even when ACP_CWD was supplied. Off by default.
ACP_ALLOW_EXECUTE=

# How long a conversation may sit idle before its adapter subprocess is stopped.
# A task parked in INPUT_REQUIRED holds its adapter regardless.
ACP_IDLE_TIMEOUT_MS=300000

# The port to listen on, the interface to bind, and the address advertised in the
# Agent Card.
#
# HOST defaults to loopback for the same reason MCP_HOST does: there is no authentication
# on the A2A side at all (`UserBuilder.noAuthentication`), so binding wider puts a coding
# agent on the network with nothing in front of it. The MCP bridge is the side meant to
# face the network — it has a bearer token. Set HOST=0.0.0.0 to open A2A up anyway;
# a shell variable wins over this file, so `HOST=0.0.0.0 yarn agent:claude` works too.
#
# PUBLIC_URL must name an address clients can actually reach, because the client takes
# its address from supportedInterfaces[].url in the card rather than from where it
# fetched the card. Blank derives it from HOST and PORT. Point it at the wire-tap
# (http://localhost:41242/) to watch the traffic — see `yarn tap`.
PORT=41241
HOST=127.0.0.1
PUBLIC_URL=

# Extra codex configuration, merged into every session (JSON).
# Note what it cannot do: codex-acp hardcodes the sandbox policy inside each mode and
# resends it on every turn, so sandbox_workspace_write set here is ignored. See the
# "what this does not protect against" note in AGENTS.md.
CODEX_CONFIG=

# --- Logs ---

# Two JSON Lines files in LOG_DIR: calls.jsonl (adapters starting, initialize, sessions,
# prompts, results, token budget) and work.jsonl (tool calls, permission decisions, file
# access). Rotated by size: at LOG_MAX_BYTES the live file becomes calls.1.jsonl and so
# on, LOG_MAX_FILES kept in total. Read by both bridges, so they share one directory.
#
# Blank means logs/ beside the repository root — already gitignored, and the right answer
# unless you want them elsewhere. A relative path here resolves against the process cwd,
# which is the repository root under `yarn`; an absolute path is resolved as given.
LOG_DIR=logs
LOG_MAX_BYTES=5000000
LOG_MAX_FILES=5

# Adapter logs. codex-acp swallows its child process's stderr unless this is set,
# so it is the first thing to turn on when Codex misbehaves.
APP_SERVER_LOGS=
CLAUDE_AGENT_LOGS=

# --- The MCP bridge: src/mcp/ (`yarn mcp`) ---
# The MCP endpoint that fronts the A2A agent, so a calling agent reaches it as a tool.

# Where the endpoint listens. 127.0.0.1 is the safe default; 0.0.0.0 is what makes it
# reachable from the rest of the local network, which is the point of this bridge.
MCP_PORT=41243
MCP_HOST=127.0.0.1

# Required once MCP_HOST leaves loopback: the hostnames accepted in the Host header,
# comma separated. Without it a wider bind has no DNS-rebinding protection at all — the
# SDK only turns that on by itself for a loopback bind. Hostnames only: the port is
# stripped before the comparison, so `192.168.1.10` and not `192.168.1.10:41243`.
# Blank is correct while MCP_HOST stays on loopback.
MCP_ALLOWED_HOSTS=

# Pin the bearer token instead of minting one per start. A generated token lands in
# .mcp-token (mode 600) and is printed at startup, but it changes on every restart,
# which invalidates whatever client config holds the old one. Blank mints one.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=

# The A2A agent to front. Reached over the network like any other peer, so it can point
# anywhere. Keep it on loopback when the agent is bound there.
# A2A_AGENTS wins when set and takes {"alias": "url"} for several agents; with a single
# agent the tools' `agent` argument may be omitted. Blank means "just A2A_URL".
A2A_URL=http://127.0.0.1:41241/
A2A_AGENTS=

# Keeping a long call alive. A client drops a tool call that goes quiet — five minutes
# for an HTTP MCP server — and a progress notification resets that window. So the bridge
# ticks every MCP_HEARTBEAT_MS while the agent is quiet. MCP_UPSTREAM_SILENCE_MS is the
# other half: ticking unconditionally would hide a wedged agent until the wall-clock
# limit (~28h), so after this much silence the turn is aborted with an error instead.
MCP_HEARTBEAT_MS=60000
MCP_UPSTREAM_SILENCE_MS=600000
