# Copy to .env and edit. .env is gitignored; this template is not.
# Only the ACP bridge (acp-agent.ts) reads this file — agent.ts needs nothing.

# Where the coding agent is allowed to work. Empty means a directory per conversation
# under .acp-sandboxes/ in this repository, created by the bridge itself. That distinction
# matters: inside a directory we made, the classifier permits shell and unverifiable
# edits; inside one you handed us, it does not.
ACP_CWD=

# Force shell and network through even when ACP_CWD was supplied. Off by default.
ACP_ALLOW_EXECUTE=

# How long a conversation may sit idle before its adapter subprocess is stopped.
# A task parked in INPUT_REQUIRED holds its adapter regardless.
ACP_IDLE_TIMEOUT_MS=300000

# Same knobs as agent.ts: the port to listen on, and the address advertised in the
# Agent Card (point it at the wire-tap to watch the traffic).
PORT=41241
PUBLIC_URL=

# Extra codex configuration, merged into every session (JSON).
# Note what it cannot do: codex-acp hardcodes the sandbox policy inside each mode and
# resends it on every turn, so sandbox_workspace_write set here is ignored. See the
# "what this does not protect against" note in AGENTS.md.
CODEX_CONFIG=

# Bridge logs. Two JSON Lines files in LOG_DIR: calls.jsonl (adapters starting,
# initialize, sessions, prompts, results, token budget) and work.jsonl (tool calls,
# permission decisions, file access). Rotated by size: at LOG_MAX_BYTES the live file
# becomes calls.1.jsonl and so on, LOG_MAX_FILES kept in total.
LOG_DIR=
LOG_MAX_BYTES=5000000
LOG_MAX_FILES=5

# Adapter logs. codex-acp swallows its child process's stderr unless this is set,
# so it is the first thing to turn on when Codex misbehaves.
APP_SERVER_LOGS=
CLAUDE_AGENT_LOGS=

# --- MCP bridge (src/mcp/, `yarn mcp`) ---
# The MCP endpoint that fronts the A2A agent, so a calling agent reaches it as a tool.

# Where the endpoint listens. The default is loopback on purpose: the SDK turns on
# DNS-rebinding protection automatically for a localhost bind, and binding wider makes
# the bearer token the only thing between a caller and an agent that can read files.
MCP_PORT=41243
MCP_HOST=127.0.0.1

# Required once MCP_HOST leaves loopback: the hostnames accepted in the Host header,
# comma separated. Without it a wider bind has no rebinding protection at all.
MCP_ALLOWED_HOSTS=

# Pin the bearer token instead of minting one per start. A generated token lands in
# .mcp-token (mode 600) and is printed at startup, but it changes on every restart,
# which invalidates whatever client config holds the old one.
MCP_TOKEN=

# The A2A agent to front. A2A_AGENTS wins when set and takes {"alias": "url"} for
# several agents; with a single agent the tools' `agent` argument may be omitted.
A2A_URL=http://localhost:41241/
A2A_AGENTS=

# Keeping a long call alive. A client drops a tool call that goes quiet — five minutes
# for an HTTP MCP server — and a progress notification resets that window. So the bridge
# ticks every MCP_HEARTBEAT_MS while the agent is quiet. MCP_UPSTREAM_SILENCE_MS is the
# other half: ticking unconditionally would hide a wedged agent until the wall-clock
# limit (~28h), so after this much silence the turn is aborted with an error instead.
MCP_HEARTBEAT_MS=60000
MCP_UPSTREAM_SILENCE_MS=600000
