# Нормализация переводов строк: в репозитории всегда LF.
* text=auto eol=lf

# Явно текстовые — чтобы diff был читаемым вне зависимости от эвристики Git.
*.ts        text diff=typescript
*.js        text diff=javascript
*.mjs       text diff=javascript
*.cjs       text diff=javascript
*.json      text
*.jsonc     text
*.md        text diff=markdown
*.yml       text
*.yaml      text
*.html      text diff=html
*.css       text diff=css
*.svg       text
*.sh        text eol=lf
*.http      text

# Лок-файл коммитим, но в diff и при подсчёте статистики он только шумит.
yarn.lock          text -diff linguist-generated=true

# Скрипты должны оставаться LF, иначе shebang ломается при checkout на Windows.
raw.sh      text eol=lf

# --- Git LFS ---
# Включается само, как только такой файл попадёт в индекс: git lfs install
# должен быть выполнен один раз на машине, иначе filter просто не сработает.
# ВАЖНО: правило действует только на файлы, добавленные ПОСЛЕ его коммита.
# Уже закоммиченный бинарник в LFS не переедет без git lfs migrate.

# Изображения (SVG сознательно оставлен текстом — это разметка)
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.webp      filter=lfs diff=lfs merge=lfs -text
*.avif      filter=lfs diff=lfs merge=lfs -text
*.bmp       filter=lfs diff=lfs merge=lfs -text
*.tif       filter=lfs diff=lfs merge=lfs -text
*.tiff      filter=lfs diff=lfs merge=lfs -text
*.ico       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text

# Видео и аудио (например, записи демо-прогонов протокола)
