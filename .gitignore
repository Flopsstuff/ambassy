# --- Node / Yarn 4 (Berry) ---
node_modules/
.npm/
*.tgz
.pnpm-store/

# Plug'n'Play is not used here (nodeLinker: node-modules), but if anyone switches the
# linker, these files must not end up in the repository.
.pnp.*

# From .yarn/ everything is ignored except what Yarn itself asks to be committed.
# The cache is global (enableGlobalCache), so .yarn/ is nearly empty here — what remains
# is install-state.gz, which is exactly what history does not need.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# .yarnrc.yml and yarn.lock ARE committed. The first holds nodeLinker, without which tsx
# will not find the modules; the second pins the SDK versions, and protocol differences
# between those versions are half the point of this repository.

# --- Logs and debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.tap/
tap-*.txt

# --- Environment and secrets ---
.env
.env.*
!.env.example
*.pem
*.key
.netrc

# --- Tool caches ---
.cache/
.tsbuildinfo
*.tsbuildinfo
.tsimp/
.eslintcache
coverage/
.nyc_output/

# --- Build output ---
# There is none for the sources — tsx runs TypeScript directly. The documentation site
# is the exception: VitePress builds docs/ into these two, and neither belongs here.
docs/.vitepress/dist/
docs/.vitepress/cache/
dist/
build/
out/

# --- Local agent artifacts ---
.claude/settings.local.json
.worktrees/

# The working directories the ACP bridge creates per conversation. They live in the
# repository rather than in /tmp deliberately: the Codex sandbox treats /tmp and $TMPDIR
# as writable and asks no permission before writing there.
.acp-sandboxes/

# The hand-made sandbox for experiments: ACP_CWD is pointed here when you want to watch
# the agent work.
workspace/

# Bridge logs: calls.jsonl and work.jsonl with their rotated copies, plus the service
# units' stdout under logs/service/.
logs/

# The MCP bridge's token: minted at startup, mode 600. A secret, not for the repository.
.mcp-token

# The local client config for that bridge: the address of a particular agent and the same
# bearer token in the clear. A secret and a machine-specific path — not for the repository.
.mcp.json

# Third-party sources pulled in to read while designing the A2A → MCP bridge.
# Reference material, not a dependency: nothing here is built or imported.
ref/

# --- macOS / editors ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
