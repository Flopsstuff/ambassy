{
  "name": "ambassy",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2023 --lib es2023,dom --allowImportingTsExtensions --skipLibCheck --strict --types node,express src/*.ts src/acp/*.ts src/mcp/*.ts",
    "agent": "tsx src/agent.ts",
    "agent:claude": "ACP_AGENT=claude tsx src/acp/agent.ts",
    "agent:codex": "ACP_AGENT=codex tsx src/acp/agent.ts",
    "client": "tsx src/client.ts",
    "tap": "tsx src/proxy.ts",
    "raw": "./src/raw.sh",
    "mcp": "tsx src/mcp/server.ts",
    "service": "./bin/ambassyctl"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@a2a-js/sdk": "^1.2.0",
    "@agentclientprotocol/claude-agent-acp": "^0.79.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
